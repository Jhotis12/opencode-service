# Server
PORT=3000
DATA_DIR=./data
DATABASE_URL=
INITIAL_ADMIN_PASSWORD=
SESSION_TTL_HOURS=168
AGENT_CHAT_TIMEOUT_MS=900000
AGENT_TURN_MAX_MS=1800000
AGENT_TURN_IDLE_MS=600000
AGENT_TURN_POLL_MS=750
AGENT_TURN_RETRY_MS=2000
CHAT_TURN_ENGINE=v2

# OpenCode V2
OPENCODE_MODE=auto          # auto | service | fake
OPENCODE_PROVIDER_TIMEOUT_MS=1800000
OPENCODE_EXPERIMENTAL_BASH_DEFAULT_TIMEOUT_MS=1800000
OPENCODE_BASE_URL=
OPENCODE_SERVICE_FILE=
OPENCODE_DB=
XDG_STATE_HOME=
ORCHESTRATOR_MODEL=         # defaults to the platform default model
PLATFORM_API_URL=http://127.0.0.1:3000
PLATFORM_SERVICE_TOKEN=
PLATFORM_GLOBAL_TOKEN=

# Error tracking (Sentry Cloud or self-hosted GlitchTip/Bugsink)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Optional embeddings provider (OpenAI-compatible). Falls back to lexical vectors.
EMBEDDINGS_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small

# La transcripción se configura por proyecto en Recursos -> Transcripción (ASR).
# Para el servicio local de docker-compose usa:
#   baseUrl: http://transcription:8000/v1
#   model:   Systran/faster-whisper-small
#   language: es
# Para terceros OpenAI-compatible usa la URL base del proveedor y su API key.

# Project channels and credentials are configured per project in the UI/vault.
# Global orchestrator channels are configured in Settings -> Canales del orquestador.
