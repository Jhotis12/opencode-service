# Server
PORT=3000
DATA_DIR=./data
DATABASE_URL=
INITIAL_ADMIN_PASSWORD=
SESSION_TTL_HOURS=168
AGENT_CHAT_TIMEOUT_MS=900000

# OpenCode V2
OPENCODE_MODE=auto          # auto | service | fake
OPENCODE_BASE_URL=
OPENCODE_SERVICE_FILE=
PLATFORM_API_URL=http://127.0.0.1:3000
PLATFORM_SERVICE_TOKEN=

# Error tracking (Sentry Cloud or self-hosted GlitchTip/Bugsink)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Optional embeddings provider (OpenAI-compatible). Falls back to lexical vectors.
EMBEDDINGS_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small

# Channels (tokens can also be stored in the vault from the UI)
TELEGRAM_BOT_TOKEN=
WHATSAPP_MODE=baileys       # baileys | cloud
